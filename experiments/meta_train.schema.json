{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Chunduri-Aditya/MetaLearnML/schemas/meta-history-v2.json",
  "title": "MetaLearnML experiment-history row",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "dataset_id",
    "dataset_version",
    "dataset_checksum",
    "dataset_name",
    "task_type",
    "n_samples",
    "n_features",
    "n_numeric",
    "n_categorical",
    "n_text",
    "n_classes",
    "class_imbalance",
    "missing_value_fraction",
    "candidate_id",
    "model_identity",
    "model_family",
    "preprocessing_name",
    "numeric_scaler",
    "numeric_imputer",
    "categorical_encoder",
    "categorical_imputer",
    "metric_name",
    "metric_objective_value",
    "metric_display_value",
    "outer_split_seed",
    "inner_fold_id",
    "repository_commit",
    "environment_hash"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "run_id": { "type": "string", "minLength": 1 },
    "dataset_id": { "type": "string", "minLength": 1 },
    "dataset_version": { "type": "string", "minLength": 1 },
    "dataset_checksum": { "type": "string", "minLength": 1 },
    "dataset_name": { "type": "string", "minLength": 1 },
    "task_type": { "enum": ["classification", "regression"] },
    "n_samples": { "type": "integer", "minimum": 0 },
    "n_features": { "type": "integer", "minimum": 0 },
    "n_numeric": { "type": "integer", "minimum": 0 },
    "n_categorical": { "type": "integer", "minimum": 0 },
    "n_text": { "type": "integer", "minimum": 0 },
    "n_classes": { "type": "integer", "minimum": 0 },
    "class_imbalance": { "type": "number" },
    "missing_value_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
    "candidate_id": { "type": "string", "minLength": 1 },
    "model_identity": { "type": "string", "minLength": 1 },
    "model_family": { "type": "string", "minLength": 1 },
    "preprocessing_name": { "type": "string", "minLength": 1 },
    "numeric_scaler": { "enum": ["standard", "minmax", "robust", "power", "none", "unknown"] },
    "numeric_imputer": { "enum": ["mean", "median", "knn", "none", "unknown"] },
    "categorical_encoder": { "enum": ["onehot", "ordinal", "none", "unknown"] },
    "categorical_imputer": { "enum": ["most_frequent", "constant", "none", "unknown"] },
    "metric_name": { "type": "string", "minLength": 1 },
    "metric_objective_value": { "type": "number" },
    "metric_display_value": { "type": "number" },
    "outer_split_seed": { "type": "integer", "minimum": 0 },
    "inner_fold_id": { "type": "integer", "minimum": 0 },
    "repository_commit": { "type": "string", "minLength": 1 },
    "environment_hash": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
