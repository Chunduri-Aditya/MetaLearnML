{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metalearnml.local/schemas/candidate-results-v1.json",
  "title": "MetaLearnML benchmark candidate result row",
  "type": "object",
  "required": [
    "schema_version",
    "profile",
    "dataset_id",
    "openml_task_id",
    "dataset_checksum",
    "task_type",
    "outer_seed",
    "inner_fold_id",
    "candidate_fold_seed",
    "candidate_universe_hash",
    "candidate_id",
    "model_identity",
    "model_family",
    "numeric_scaler",
    "numeric_imputer",
    "categorical_encoder",
    "categorical_imputer",
    "metric_name",
    "status",
    "repository_commit",
    "environment_hash"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "profile": {"const": "balanced-15-v1"},
    "dataset_id": {"type": "string", "minLength": 1},
    "openml_task_id": {"type": "integer", "minimum": 1},
    "dataset_checksum": {"type": "string", "minLength": 32},
    "task_type": {"enum": ["classification", "regression"]},
    "outer_seed": {"type": "integer", "minimum": 0},
    "inner_fold_id": {"type": "integer", "minimum": 0},
    "candidate_fold_seed": {"type": "integer", "minimum": 0},
    "candidate_universe_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "candidate_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "model_identity": {"type": "string", "minLength": 1},
    "model_family": {"type": "string", "minLength": 1},
    "numeric_scaler": {"type": "string"},
    "numeric_imputer": {"type": "string"},
    "categorical_encoder": {"type": "string"},
    "categorical_imputer": {"type": "string"},
    "metric_name": {"type": "string"},
    "status": {"enum": ["success", "failed", "skipped"]},
    "repository_commit": {"type": "string", "minLength": 1},
    "environment_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": true
}
